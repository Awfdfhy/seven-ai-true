    ],
    "performancePerception": [
      "input response",
      "streaming start",
      "scroll smoothness",
      "long history",
      "no blocking chrome"
    ],
    "accessibility": [
      "contrast",
      "focus",
      "semantics",
      "reduced motion",
      "touch targets"
    ]
  },
  "verdicts": {
    "9.0-10": "Premium: coherent, confident, delightful; no material rough edges in core journeys.",
    "8.2-8.9": "Release Candidate: strong product; only bounded non-core polish remains.",
    "7.0-8.1": "Functional but not premium: visible cohesion/friction issues; do not call final.",
    "5.0-6.9": "Prototype/beta quality: major UX or visual weaknesses.",
    "0-4.9": "Broken/incoherent product experience."
  },
  "evidenceRequired": [
    "exact build SHA",
    "functional gate output",
    "Android screenshots",
    "RTL screenshot",
    "day/night evidence",
    "judge reports",
    "known limitations"
  ],
  "judgeRule": "A score without concrete evidence is invalid. Any hard fail overrides weighted score."
}
