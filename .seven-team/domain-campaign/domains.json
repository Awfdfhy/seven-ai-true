{
  "schemaVersion": 1,
  "name": "Seven Domain-by-Domain Internet Research & Improvement Campaign",
  "enabled": true,
  "goal": "Every major Seven subsystem receives independent internet research, current-state audit, architecture plan, improvement implementation, verification and durable learning.",
  "researchPolicy": {
    "minPrimaryRatio": 0.5,
    "requireUrls": true,
    "requireCurrentStateAudit": true,
    "requireBenchmarkOrEval": true,
    "requireFailureModes": true,
    "requireSecurityPrivacyImpact": true,
    "requirePerformanceImpact": true,
    "requireAndroidImpact": true,
    "requireArabicRtlImpact": true,
    "requireImplementationPhases": true,
    "requireAcceptanceTests": true,
    "requireKnownUnknowns": true,
    "sourcePreference": [
      "official specification",
      "primary research paper",
      "official framework/product docs",
      "recognized benchmark",
      "high-quality engineering write-up",
      "community evidence only for pain points"
    ],
    "staleRule": "For rapidly changing software/agent systems, prefer sources from the last 24 months unless the older source is foundational.",
    "noCopyRule": "External products are evidence and design/architecture references, never permission to copy proprietary UI/assets/code."
  },
